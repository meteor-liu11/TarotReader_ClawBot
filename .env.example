# ── 服务 ─────────────────────────────────────────────
PORT=8787
PUBLIC_BASE_URL=http://127.0.0.1:8787
DB_PATH=./data/demo.db

# ── 安全 ─────────────────────────────────────────────
# 一次性抽卡 token 的有效期（分钟）
SESSION_TTL_MINUTES=10
# 内部回调鉴权密钥（业务服务 ← OpenClaw Agent）
INTERNAL_HMAC_SECRET=change-me-demo-secret
# 每个微信用户每分钟 / 每天的抽卡上限
RATE_PER_MINUTE=5
RATE_PER_DAY=30
# 新用户赠送的体验点数（0 = 不赠送）
WELCOME_CREDITS=5

# ── OpenClaw 网关 ────────────────────────────────────
# mock = 本地模拟网关（无需安装 OpenClaw，闭环可跑）
# live = 真实调用 POST /hooks/agent
GATEWAY_MODE=mock
GATEWAY_URL=http://127.0.0.1:18789
HOOK_TOKEN=replace-with-your-hooks-token
AGENT_ID=tarot
CHANNEL=openclaw-weixin
ACCOUNT_ID=

# ── 解读生成 ─────────────────────────────────────────
# template = 内置确定性解读（离线可跑）
# llm      = 调用 OpenAI 兼容接口
READING_MODE=template
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
